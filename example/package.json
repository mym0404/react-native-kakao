{
  "name": "kakao-example",
  "version": "0.0.1",
  "private": true,
  "main": "src/root.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port=80",
    "prebuild:android": "expo prebuild -p android --no-install",
    "prebuild:android:clean": "expo prebuild -p android --clean --no-install",
    "prebuild:ios": "expo prebuild -p ios --no-install && cp ios/.xcode.env ios/.xcode.env.local",
    "prebuild:ios:clean": "expo prebuild -p ios --clean --no-install && cp ios/.xcode.env ios/.xcode.env.local",
    "prebuild": "yarn prebuild:android && yarn prebuild:ios",
    "prebuild:clean": "yarn prebuild:android:clean && yarn prebuild:ios:clean",
    "typecheck": "tsc --noEmit",
    "theme:gen": "generate-theme-type src/design/AppTheme.ts ./../node_modules/@react-native-styled-system/core/lib/typescript/src/@types/ThemedTypings.d.ts",
    "pod": "cd ios && mise exec -- bundle install && mise exec -- bundle exec pod install"
  },
  "dependencies": {
    "@mj-studio/js-util": "catalog:",
    "@mj-studio/react-util": "^0.0.20",
    "@react-native-kakao/channel": "workspace:*",
    "@react-native-kakao/core": "workspace:*",
    "@react-native-kakao/navi": "workspace:*",
    "@react-native-kakao/share": "workspace:*",
    "@react-native-kakao/social": "workspace:*",
    "@react-native-kakao/user": "workspace:*",
    "@react-native-styled-system/core": "~1.2.1",
    "expo": "catalog:",
    "expo-constants": "~17.1.5",
    "expo-dev-client": "~5.1.8",
    "expo-linking": "~7.1.4",
    "expo-router": "~5.0.5",
    "expo-status-bar": "~2.2.3",
    "query-string": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-flash-message": "^0.4.2",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "expo-build-properties": "~0.14.6",
    "metro": "^0.82.2",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18"
  }
}
