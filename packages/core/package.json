{
  "name": "@react-native-kakao/core",
  "description": "React Native Kakao Core SDK",
  "version": "3.0.0",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "expo-config-plugin/build/**",
    "app.plugin.js"
  ],
  "author": "MJ Studio <mym0404@gmail.com> (https://github.com/mym0404)",
  "homepage": "https://rnkakao.mjstudio.net",
  "scripts": {
    "prepare": "husky",
    "build:expo-config-plugin": "tsc --project ./expo-config-plugin",
    "prepack": "yarn build:expo-config-plugin && bob build && zx ../../script/remove-web-declaration-files.mjs .",
    "clean": "del-cli android/ lib"
  },
  "keywords": [
    "react-native",
    "kakao",
    "kakao-sdk",
    "typescript",
    "javascript",
    "react",
    "expo",
    "kakao-login",
    "kakao-auth",
    "kakao-core",
    "kakao-navi",
    "kakao-channel",
    "kakaotalk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mym0404/react-native-kakao.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/crypto-js": "^4",
    "@types/react": "catalog:",
    "del-cli": "catalog:",
    "expo": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-builder-bob": "catalog:",
    "typescript": "catalog:",
    "zx": "catalog:"
  },
  "peerDependencies": {
    "expo": ">=52.0.0",
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "workspaces": [
    "example",
    "packages/*"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNCKakaoCoreSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "net.mjstudio.rnkakao.core"
    }
  },
  "sdkVersions": {
    "ios": {
      "core": "2.22.0",
      "share": "2.22.0",
      "user": "2.22.0",
      "navi": "2.22.0",
      "friend": "2.22.0",
      "talk": "2.22.0"
    },
    "android": {
      "minSdk": 21,
      "targetSdk": 33,
      "compileSdk": 33,
      "ndk": "21.4.7075529",
      "core": "2.20.1",
      "share": "2.20.1",
      "user": "2.20.1",
      "navi": "2.20.1",
      "friend": "2.20.1",
      "talk": "2.20.1"
    }
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "query-string": "catalog:",
    "return-fetch": "^0.4.5"
  }
}
